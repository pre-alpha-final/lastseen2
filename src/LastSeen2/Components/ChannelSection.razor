@using LastSeen2.Contracts
<section class="channel-group @Group.ToString().ToLowerInvariant()" aria-labelledby="@HeadingId">
    <div class="group-heading"><h3 id="@HeadingId"><span aria-hidden="true">@Symbol</span> @Group</h3><span class="count" aria-label="@($"{Channels.Length} channels")">@Channels.Length</span></div>
    @if (Channels.Length == 0)
    {
        <p class="group-empty">No @Group.ToString().ToLowerInvariant() channels yet.</p>
    }
    else
    {
        <ul class="channel-list">
            @foreach (var channel in Channels)
            {
                <li @key="channel.Id"><ProviderIcon Url="@channel.Url" /><a href="@channel.Url" target="_blank" rel="noopener noreferrer">@channel.Name<span class="visually-hidden"> (opens in a new tab)</span></a><div class="item-actions">
                    <button class="btn btn-outline-light" aria-label="@($"Edit channel: {channel.Name}")" @onclick="() => OnEdit.InvokeAsync(channel)">✎</button>
                    <button class="btn delete-button" aria-label="@($"Delete channel: {channel.Name}")" @onclick="() => OnDelete.InvokeAsync(channel)">×</button>
                </div></li>
            }
        </ul>
    }
</section>
@code {
    [Parameter] public ChannelGroup Group { get; set; }
    [Parameter, EditorRequired] public ChannelBookmark[] Channels { get; set; } = [];
    [Parameter] public EventCallback<ChannelBookmark> OnEdit { get; set; }
    [Parameter] public EventCallback<ChannelBookmark> OnDelete { get; set; }
    private string HeadingId => $"group-{Group}";
    private string Symbol => Group switch { ChannelGroup.Frequent => "☆", ChannelGroup.Infrequent => "◷", _ => "▱" };
}
