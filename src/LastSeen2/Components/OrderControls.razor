@using LastSeen2.Contracts
<div class="order-controls">
    <span class="drag-handle" title="Drag to move" aria-hidden="true">⠿</span>
    <button class="btn btn-outline-light" disabled="@(Disabled || Index == 0)" aria-label="@($"Move {Name} up")" @onclick="() => OnMove.InvokeAsync(Index - 1)">↑</button>
    <button class="btn btn-outline-light" disabled="@(Disabled || Index == Count - 1)" aria-label="@($"Move {Name} down")" @onclick="() => OnMove.InvokeAsync(Index + 1)">↓</button>
    @if (Group is not null)
    {
        <select class="form-select" aria-label="@($"Move {Name} to group")" value="@Group" disabled="@Disabled" @onchange="ChangeGroup">
            @foreach (var group in Enum.GetValues<ChannelGroup>()) { <option value="@group">@group</option> }
        </select>
    }
</div>
@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Index { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public ChannelGroup? Group { get; set; }
    [Parameter] public EventCallback<int> OnMove { get; set; }
    [Parameter] public EventCallback<ChannelGroup> OnGroup { get; set; }
    private Task ChangeGroup(ChangeEventArgs args) => Enum.TryParse<ChannelGroup>(args.Value?.ToString(), out var group) ? OnGroup.InvokeAsync(group) : Task.CompletedTask;
}
