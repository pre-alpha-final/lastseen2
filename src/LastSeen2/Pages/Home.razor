@page "/"
@using LastSeen2.Contracts
@using LastSeen2.Components
@using LastSeen2.Services
@inject BoardApiClient Api
@inject AccessSession Session
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>LastSeen2</PageTitle>
<a class="skip-link" href="#main">Skip to content</a>
<header class="app-header">
    <a class="brand" href="/" aria-label="LastSeen2 home">lastseen<span>2</span></a>
    <div class="header-actions">
        @if (unlocked)
        {
            <button class="btn btn-outline-light" @onclick="LoadBoardAsync" disabled="@(busy || ordering)"><UiIcon Name="refresh" />Refresh</button>
        }
        @if (unlocked || Session.Key is not null)
        {
            <button class="btn btn-outline-light" @onclick="LockAsync"><UiIcon Name="lock" />Lock</button>
        }
    </div>
</header>
<main id="main" tabindex="-1">
    @if (restoring)
    {
        <div class="state-panel" role="status">Restoring your session…</div>
    }
    else if (!unlocked)
    {
        <section class="unlock-panel panel" aria-labelledby="unlock-heading">
            <h1 id="unlock-heading">Unlock board</h1>
            <form @onsubmit="UnlockAsync" @onsubmit:preventDefault>
                <label for="access-key" class="form-label">Access key</label>
                <input id="access-key" class="form-control" type="password" autocomplete="current-password" required @bind="enteredKey" disabled="@busy" aria-describedby="key-help unlock-error" />
                <p id="key-help" class="help-text">Kept only for this browser tab’s session. Use Lock when you’re done.</p>
                @if (error is not null) { <p id="unlock-error" class="error-message" role="alert">@error</p> }
                <button class="btn btn-primary unlock-button" type="submit" disabled="@busy">@(busy ? "Unlocking…" : "Unlock board")</button>
                @if (Session.Key is not null)
                {
                    <button class="btn btn-outline-light retry-session" type="button" @onclick="RestoreAsync" disabled="@busy">Retry saved session</button>
                }
            </form>
        </section>
    }
    else
    {
        @if (error is not null)
        {
            <div class="state-panel error-message" role="alert"><p>@error</p><button class="btn btn-primary" @onclick="LoadBoardAsync" disabled="@busy">@(orderReview ? "Reload and review" : "Retry loading board")</button></div>
        }
        <p class="order-status" role="status">@orderStatus</p>
        @if (busy) { <p class="loading-note" role="status">Loading bookmarks…</p> }
        @if (board is not null)
        {
            <div class="board-grid" data-revision="@board.Revision" @ref="boardElement" data-order-disabled="@((ControlsDisabled || dialogOpen).ToString().ToLowerInvariant())" aria-busy="@ordering.ToString().ToLowerInvariant()">
                <section class="panel videos-panel" aria-labelledby="videos-heading">
                    <div class="section-heading"><h2 id="videos-heading"><span class="section-symbol"><UiIcon Name="bookmark" /></span> Saved Videos</h2><div class="heading-actions"><span class="visually-hidden" aria-label="@($"{board.Videos.Length} saved videos")">@board.Videos.Length</span><button disabled="@ControlsDisabled" class="btn btn-primary" @onclick="() => OpenVideo(null)"><UiIcon Name="plus" /><span><span class="visually-hidden">+ </span>Add Video</span></button></div></div>
                    @if (board.Videos.Length == 0)
                    {
                        <div class="empty-videos"><span aria-hidden="true">▷</span><p>No saved videos yet.</p></div>
                    }
                    else
                    {
                        <ul class="video-list" data-order-list="videos">@foreach (var video in board.Videos) { <VideoRow @key="video.Id" Video="video" Index="Array.IndexOf(board.Videos, video)" Count="board.Videos.Length" Disabled="ControlsDisabled" OnMove="i => MoveVideoAsync(video.Id, i)" OnEdit="v => OpenVideo(v)" OnDelete="v => OpenVideo(v, true)" /> }</ul>
                    }
                </section>
                <section class="panel channels-panel" aria-labelledby="channels-heading">
                    <div class="section-heading"><h2 id="channels-heading"><span class="section-symbol"><UiIcon Name="users" /></span> Channels</h2><div class="heading-actions"><span class="visually-hidden" aria-label="@($"{ChannelCount} channels")">@ChannelCount</span><button disabled="@ControlsDisabled" class="btn btn-primary" @onclick="() => OpenChannel(null)"><UiIcon Name="plus" /><span><span class="visually-hidden">+ </span>Add Channel</span></button></div></div>
                    <ChannelSection Disabled="ControlsDisabled" OnMove="MoveChannelAsync" Group="ChannelGroup.Frequent" OnEdit="c => OpenChannel(c)" OnDelete="c => OpenChannel(c, true)" Channels="board.Channels.Frequent" />
                    <ChannelSection Disabled="ControlsDisabled" OnMove="MoveChannelAsync" Group="ChannelGroup.Infrequent" OnEdit="c => OpenChannel(c)" OnDelete="c => OpenChannel(c, true)" Channels="board.Channels.Infrequent" />
                    <ChannelSection Disabled="ControlsDisabled" OnMove="MoveChannelAsync" Group="ChannelGroup.Archived" OnEdit="c => OpenChannel(c)" OnDelete="c => OpenChannel(c, true)" Channels="board.Channels.Archived" />
                </section>
            </div>
        }
    }
    @if (dialogOpen && board is not null && unlocked)
    {
        <BookmarkDialog IsVideo="editingVideo" Delete="deleting" Video="selectedVideo" Channel="selectedChannel" Revision="board.Revision" OnBoard="ApplyBoard" OnClose="CloseDialog" OnUnauthorized="HandleErrorAsync" />
    }
</main>

@code {
    private ElementReference boardElement;
    private IJSObjectReference? module;
    private DotNetObjectReference<Home>? reference;
    private bool ordering, orderReview, disposed;
    private string? orderStatus;
    private bool ControlsDisabled => busy || ordering || orderReview;

    [JSInvokable]
    public Task DropAsync(string kind, string id, string group, int index) =>
        Guid.TryParse(id, out var itemId) && !ControlsDisabled && !dialogOpen
            ? kind == "videos" ? MoveVideoAsync(itemId, index)
                : Enum.TryParse<ChannelGroup>(group, out var destination) ? MoveChannelAsync((itemId, destination, index)) : Task.CompletedTask
            : Task.CompletedTask;

    private Task MoveVideoAsync(Guid id, int index)
    {
        if (board is null || ControlsDisabled) return Task.CompletedTask;
        var ids = board.Videos.Select(v => v.Id).ToList();
        var old = ids.IndexOf(id);
        if (old < 0 || index < 0 || index >= ids.Count || old == index) return Task.CompletedTask;
        ids.RemoveAt(old); ids.Insert(index, id);
        var request = new ReorderVideosRequest(board.Revision, ids.ToArray());
        return SaveOrderAsync(key => Api.ReorderVideosAsync(key, request));
    }

    private Task MoveChannelAsync((Guid Id, ChannelGroup Group, int Index) move)
    {
        if (board is null || ControlsDisabled) return Task.CompletedTask;
        var request = new MoveChannelRequest(board.Revision, move.Group, move.Index);
        return SaveOrderAsync(key => Api.MoveChannelAsync(key, move.Id, request));
    }

    private async Task SaveOrderAsync(Func<string, Task<BoardSnapshot>> save)
    {
        if (Session.Key is not { } key || disposed) return;
        var attempt = generation;
        ordering = true;
        orderStatus = "Saving order…";
        StateHasChanged();
        try
        {
            var result = await save(key);
            if (attempt != generation || disposed) return;
            ApplyBoard(result);
            orderStatus = null;
        }
        catch (ApiClientException ex)
        {
            if (attempt != generation || disposed) return;
            // A failed response may follow a committed write. Require an explicit fresh read.
            board = null;
            orderReview = true;
            orderStatus = null;
            await HandleErrorAsync(ex);
        }
        finally { if (attempt == generation && !disposed) { ordering = false; StateHasChanged(); } }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        generation++;
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("dispose"); await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        reference?.Dispose();
    }

    private bool dialogOpen, editingVideo, deleting;
    private VideoBookmark? selectedVideo;
    private ChannelBookmark? selectedChannel;
    private void OpenVideo(VideoBookmark? value, bool delete = false) { if (ControlsDisabled) return; selectedVideo = value; selectedChannel = null; editingVideo = true; deleting = delete; dialogOpen = true; }
    private void OpenChannel(ChannelBookmark? value, bool delete = false) { if (ControlsDisabled) return; selectedChannel = value; selectedVideo = null; editingVideo = false; deleting = delete; dialogOpen = true; }
    private void CloseDialog() => dialogOpen = false;
    private void ApplyBoard(BoardSnapshot value) { board = value; error = null; }
    private string enteredKey = "";
    private string? error;
    private BoardSnapshot? board;
    private bool restoring = true, busy, unlocked;
    private int generation;
    private int ChannelCount => board is null ? 0 : board.Channels.Frequent.Length + board.Channels.Infrequent.Length + board.Channels.Archived.Length;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./ordering.js");
        reference ??= DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("sync", board is null ? null : boardElement, reference);
        if (firstRender) { await RestoreAsync(); StateHasChanged(); }
    }

    private async Task RestoreAsync()
    {
        busy = true;
        error = null;
        var attempt = generation;
        try
        {
            await Session.RestoreAsync();
            if (!string.IsNullOrEmpty(Session.Key))
            {
                await Api.CheckKeyAsync(Session.Key);
                if (attempt != generation) return;
                unlocked = true;
            }
        }
        catch (ApiClientException ex) { if (attempt == generation) await HandleErrorAsync(ex); }
        catch (JSException) { error = "Session storage is unavailable. Enable browser storage and retry."; }
        finally { restoring = false; busy = false; }
        if (unlocked && attempt == generation) await LoadBoardAsync();
    }

    private async Task UnlockAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(enteredKey)) return;
        busy = true;
        error = null;
        var attempt = generation;
        var candidate = enteredKey;
        try
        {
            await Api.CheckKeyAsync(candidate);
            if (attempt != generation) return;
            await Session.SaveAsync(candidate);
            if (attempt != generation) { await Session.ClearAsync(); return; }
            enteredKey = "";
            unlocked = true;
        }
        catch (ApiClientException ex) { if (attempt == generation) await HandleErrorAsync(ex); }
        catch (JSException) { error = "Could not save this session. Enable browser storage and try again."; }
        finally { busy = false; }
        if (unlocked) await LoadBoardAsync();
    }

    private async Task LoadBoardAsync()
    {
        if (Session.Key is null) return;
        var attempt = generation;
        busy = true;
        error = null;
        board = null;
        orderStatus = null;
        try
        {
            var result = await Api.GetBoardAsync(Session.Key);
            if (attempt == generation && unlocked) { board = result; orderReview = false; }
        }
        catch (ApiClientException ex) { if (attempt == generation) await HandleErrorAsync(ex); }
        finally { if (attempt == generation) busy = false; }
    }

    private async Task HandleErrorAsync(ApiClientException ex)
    {
        if (ex.Unauthorized) await LockAsync();
        error = ex.Message + (error is null ? "" : " " + error);
    }

    private async Task LockAsync()
    {
        generation++;
        ordering = false;
        orderReview = false;
        orderStatus = null;
        dialogOpen = false;
        unlocked = false;
        board = null;
        enteredKey = "";
        busy = false;
        error = null;
        try { await Session.ClearAsync(); }
        catch (JSException) { error = "Could not clear browser storage. Close this tab to end its saved session."; }
    }
}
